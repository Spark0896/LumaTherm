<UserControl x:Class="LumaTherm.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:LumaTherm.App.Converters"
             Language="ru-RU"
             MinWidth="420" Background="Transparent"
             SizeChanged="SettingsView_SizeChanged">
    <UserControl.Resources>
        <converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" />
        <Style x:Key="SettingsPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SubheadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,14" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#FF111419" />
            <Setter Property="Background" Value="{StaticResource ColdColorBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ColdColorBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ColorCardStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource PanelSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#18FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="TemperatureEditorStyle" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="31" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
        </Style>
        <Style x:Key="ApplicationToggleStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SettingsRoot" Margin="25,20,25,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="57*" />
                <ColumnDefinition x:Name="ColumnGap" Width="14" />
                <ColumnDefinition x:Name="RightColumn" Width="43*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Настройки" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="Температурная шкала, плавность и поведение приложения" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Изменения применяются после сохранения" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <Ellipse Width="7" Height="7" Margin="8,0,0,0" Fill="{StaticResource SuccessColorBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ValidationText" Grid.Row="1" Grid.ColumnSpan="3" MinHeight="22" Margin="0,0,0,8"
                       Text="{Binding ValidationMessage}" Foreground="#FF858B" FontSize="12" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="{Binding ValidationMessage}"
                       automation:AutomationProperties.LiveSetting="Assertive" />

            <StackPanel x:Name="LeftSettingsStack" Grid.Row="2" Grid.Column="0">
                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Цветовая шкала" />
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Три опорные точки образуют непрерывный градиент" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button x:Name="ColdColorButton" Grid.Column="0" Style="{StaticResource ColorCardStyle}" Command="{Binding PickColdColorCommand}" automation:AutomationProperties.Name="Выбрать цвет холодной зоны">
                                <StackPanel><TextBlock Text="Холодно" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><Border Height="28" Margin="0,9,0,8" CornerRadius="7" Background="{Binding ColdColor, Converter={StaticResource RgbColorBrushConverter}}" /><TextBlock Text="{Binding ColdColorHex}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                            <Button x:Name="WarmColorButton" Grid.Column="1" Style="{StaticResource ColorCardStyle}" Command="{Binding PickWarmColorCommand}" automation:AutomationProperties.Name="Выбрать цвет тёплой зоны">
                                <StackPanel><TextBlock Text="Тепло" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><Border Height="28" Margin="0,9,0,8" CornerRadius="7" Background="{Binding WarmColor, Converter={StaticResource RgbColorBrushConverter}}" /><TextBlock Text="{Binding WarmColorHex}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                            <Button x:Name="HotColorButton" Grid.Column="2" Style="{StaticResource ColorCardStyle}" Margin="0" Command="{Binding PickHotColorCommand}" automation:AutomationProperties.Name="Выбрать цвет пиковой зоны">
                                <StackPanel><TextBlock Text="Горячо" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><Border Height="28" Margin="0,9,0,8" CornerRadius="7" Background="{Binding HotColor, Converter={StaticResource RgbColorBrushConverter}}" /><TextBlock Text="{Binding HotColorHex}" FontWeight="SemiBold" /></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Температурные пределы" />
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="Значения проверяются и не могут пересекаться" />
                        <TextBlock Text="Холодная зона" Margin="0,0,0,5" />
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider x:Name="ColdTemperatureSlider" Minimum="0" Maximum="120" Value="{Binding ColdTemperature}" automation:AutomationProperties.Name="Температура холодной зоны" />
                            <TextBox x:Name="ColdTemperatureEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}" Text="{Binding ColdTemperature, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.#}}" automation:AutomationProperties.Name="Температура холодной зоны, градусов Цельсия" />
                        </Grid>
                        <TextBlock Text="Тёплая зона" Margin="0,0,0,5" />
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider x:Name="WarmTemperatureSlider" Minimum="0" Maximum="120" Value="{Binding WarmTemperature}" automation:AutomationProperties.Name="Температура тёплой зоны" />
                            <TextBox x:Name="WarmTemperatureEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}" Text="{Binding WarmTemperature, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.#}}" automation:AutomationProperties.Name="Температура тёплой зоны, градусов Цельсия" />
                        </Grid>
                        <TextBlock Text="Пиковая зона" Margin="0,0,0,5" />
                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider x:Name="HotTemperatureSlider" Minimum="0" Maximum="120" Value="{Binding HotTemperature}" automation:AutomationProperties.Name="Температура пиковой зоны" />
                            <TextBox x:Name="HotTemperatureEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}" Text="{Binding HotTemperature, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.#}}" automation:AutomationProperties.Name="Температура пиковой зоны, градусов Цельсия" />
                        </Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Плавность перехода" FontWeight="SemiBold" /><Slider x:Name="SmoothingSlider" Margin="0,8,0,0" Minimum="0.1" Maximum="5" TickFrequency="0.1" Value="{Binding SmoothingSeconds}" automation:AutomationProperties.Name="Плавность перехода в секундах" /></StackPanel>
                            <TextBox x:Name="SmoothingEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}" VerticalAlignment="Bottom" Text="{Binding SmoothingSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.0}}" automation:AutomationProperties.Name="Плавность перехода, секунд" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="EditorActions" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0" Content="Сбросить" Command="{Binding ResetDefaultsCommand}" automation:AutomationProperties.Name="Сбросить значения по умолчанию" />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Content="Сохранить" Command="{Binding SaveCommand}" automation:AutomationProperties.Name="Сохранить настройки" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RightSettingsStack" Grid.Row="2" Grid.Column="2">
                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Приложение" Margin="0,0,0,8" />
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Запускать вместе с Windows" FontWeight="SemiBold" /><TextBlock Text="По умолчанию выключено" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><CheckBox x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding IsAutostartEnabled}" automation:AutomationProperties.Name="Запускать вместе с Windows" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Сворачивать при закрытии" FontWeight="SemiBold" /><TextBlock Text="Приложение продолжит работу в трее" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><CheckBox x:Name="MinimizeToTrayToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding MinimizeToTray}" automation:AutomationProperties.Name="Сворачивать приложение в трей при закрытии" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Показывать уведомления" FontWeight="SemiBold" /><TextBlock Text="Ошибки датчика и потеря устройства" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><CheckBox x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding NotificationsEnabled}" automation:AutomationProperties.Name="Показывать уведомления" /></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Оборудование" Margin="0,0,0,10" />
                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource ColdColorBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding LightingDeviceName}" FontWeight="SemiBold" /><TextBlock Text="{Binding LightingHardwareStatus}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><TextBlock Grid.Column="2" Text="LampArray" Margin="10,0,0,0" Foreground="{StaticResource SuccessColorBrush}" VerticalAlignment="Center" /></Grid>
                        <ComboBox x:Name="LightingDeviceSelector" Margin="30,10,0,8" MinHeight="32" ItemsSource="{Binding LightingDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedLightingDeviceId}" automation:AutomationProperties.Name="Предпочтительное устройство Windows LampArray">
                            <ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLightingDeviceSelectorVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                        </ComboBox>
                        <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource WarmColorBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding GpuName}" FontWeight="SemiBold" /><TextBlock Text="NVIDIA NVML · резерв: MSI Afterburner" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><TextBlock Grid.Column="2" Text="GPU" Margin="10,0,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" /></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Меню в трее" Margin="0,0,0,10" />
                        <Border Background="{StaticResource RailBackgroundBrush}" CornerRadius="10" Padding="13">
                            <StackPanel>
                                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition /></Grid.ColumnDefinitions><Image Width="28" Height="28" Source="{StaticResource LogoDrawingImage}" /><StackPanel Grid.Column="1"><TextBlock Text="LumaTherm" FontWeight="SemiBold" /><TextBlock Text="Термосинхронизация активна" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Grid>
                                <TextBlock Text="Температура GPU                         68°C" Margin="0,5" />
                                <TextBlock Text="Открыть LumaTherm                         ↗" Margin="0,5" />
                                <TextBlock Text="Выключить режим                           ●" Margin="0,5" />
                                <TextBlock Text="Выход" Margin="0,5" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
