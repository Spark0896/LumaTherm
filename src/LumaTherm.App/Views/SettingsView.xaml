<UserControl x:Class="LumaTherm.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:controls="clr-namespace:LumaTherm.App.Controls"
             xmlns:converters="clr-namespace:LumaTherm.App.Converters"
             xmlns:settings="clr-namespace:LumaTherm.Core.Settings;assembly=LumaTherm.Core"
             Language="ru-RU"
             MinWidth="420" Background="Transparent"
             SizeChanged="SettingsView_SizeChanged">
    <UserControl.Resources>
        <converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" />
        <Style x:Key="SettingsPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="SubheadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,14" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionChrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionChrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionChrome" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionChrome" Property="BorderBrush" Value="{StaticResource ColdColorBrush}" /><Setter TargetName="ActionChrome" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionChrome" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#FF111419" />
            <Setter Property="Background" Value="{StaticResource ColdColorBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ColdColorBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TemperatureEditorStyle" TargetType="TextBox">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#FF171B20" />
            <Setter Property="BorderBrush" Value="#557E8994" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="EditorChrome" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="EditorChrome" Property="BorderBrush" Value="#FF7E8994" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="EditorChrome" Property="BorderBrush" Value="{StaticResource ColdColorBrush}" /><Setter TargetName="EditorChrome" Property="BorderThickness" Value="2" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ApplicationToggleStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="SwitchRoot" Width="34" Height="20" Background="Transparent">
                            <Border x:Name="SwitchTrack" Width="34" Height="18" CornerRadius="9" Background="#FF363D43" BorderBrush="#22FFFFFF" BorderThickness="1" />
                            <Ellipse x:Name="SwitchThumb" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="#FFDAE4E9" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource ColdColorBrush}" /><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="SwitchThumb" Property="Fill" Value="#FF111419" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#FF8FDCF9" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#FFFFFFFF" /><Setter TargetName="SwitchTrack" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchRoot" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="SettingsRoot" Margin="25,20,25,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="57*" />
                <ColumnDefinition x:Name="ColumnGap" Width="14" />
                <ColumnDefinition x:Name="RightColumn" Width="43*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.Title}" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Settings.Subtitle}" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Settings.ApplyAfterSave}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <Ellipse Width="7" Height="7" Margin="8,0,0,0" Fill="{StaticResource SuccessColorBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ValidationText" Grid.Row="1" Grid.ColumnSpan="3" MinHeight="22" Margin="0,0,0,8"
                       Text="{Binding ValidationMessage}" Foreground="#FFFF858B" FontSize="12" TextWrapping="Wrap"
                       automation:AutomationProperties.Name="{Binding ValidationMessage}"
                       automation:AutomationProperties.LiveSetting="Assertive" />

            <StackPanel x:Name="LeftSettingsStack" Grid.Row="2" Grid.Column="0">
                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ColorScaleHeading" Style="{StaticResource SectionHeadingStyle}" Text="{DynamicResource Settings.ColorScale}" />
                        <TextBlock Style="{StaticResource SubheadingStyle}" Text="{DynamicResource Settings.ColorScaleHint}" />
                        <controls:ThermalProfileEditor x:Name="ProfileEditorControl" DataContext="{Binding ProfileEditor}" />
                        <Border Margin="0,10,0,0" Padding="12" CornerRadius="8" Background="{StaticResource PanelSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.SelectedPoint}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedPointColorHex}" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <TextBox x:Name="SelectedPointTemperatureEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}"
                                         Text="{Binding SelectedPointTemperature, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.#}}"
                                         automation:AutomationProperties.Name="{DynamicResource Settings.PointTemperature}" />
                                <Button x:Name="SelectedPointColorButton" Grid.Column="2" Width="54" Height="32" Margin="10,0,0,0"
                                        Background="{Binding SelectedPoint.Color, Converter={StaticResource RgbColorBrushConverter}}"
                                        Command="{Binding PickSelectedColorCommand}"
                                        automation:AutomationProperties.Name="{DynamicResource Settings.PointColor}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{DynamicResource Settings.SmoothingSeconds}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider x:Name="SmoothingSlider" Minimum="0.1" Maximum="5" TickFrequency="0.1" Value="{Binding SmoothingSeconds}"
                                    automation:AutomationProperties.Name="{DynamicResource Settings.SmoothingSeconds}" />
                            <TextBox x:Name="SmoothingEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}"
                                     Text="{Binding SmoothingSeconds, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, StringFormat={}{0:0.0}}"
                                     automation:AutomationProperties.Name="{DynamicResource Settings.SmoothingSeconds}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="EditorActions" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ResetButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,9,0"
                            Content="{DynamicResource Settings.Reset}" Command="{Binding ResetDefaultsCommand}"
                            automation:AutomationProperties.Name="{DynamicResource Settings.Reset}" />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Settings.Save}" Command="{Binding SaveCommand}"
                            automation:AutomationProperties.Name="{DynamicResource Accessibility.SaveSettings}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RightSettingsStack" Grid.Row="2" Grid.Column="2">
                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{DynamicResource Settings.Application}" Margin="0,0,0,8" />
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.Language}" FontWeight="SemiBold" VerticalAlignment="Center" /><ComboBox x:Name="LanguageSelector" Grid.Column="1" MinWidth="132" SelectedValuePath="Tag" SelectedValue="{Binding SelectedLanguage}" automation:AutomationProperties.Name="{DynamicResource Settings.Language}"><ComboBoxItem Tag="{x:Static settings:AppLanguage.System}" Content="{DynamicResource Settings.LanguageSystem}" /><ComboBoxItem Tag="{x:Static settings:AppLanguage.Russian}" Content="{DynamicResource Settings.LanguageRussian}" /><ComboBoxItem Tag="{x:Static settings:AppLanguage.English}" Content="{DynamicResource Settings.LanguageEnglish}" /></ComboBox></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.LaunchWithWindows}" FontWeight="SemiBold" /><CheckBox x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding IsAutostartEnabled}" automation:AutomationProperties.Name="{DynamicResource Settings.LaunchWithWindows}" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.MinimizeOnClose}" FontWeight="SemiBold" /><CheckBox x:Name="MinimizeToTrayToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding MinimizeToTray}" automation:AutomationProperties.Name="{DynamicResource Settings.MinimizeOnClose}" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.Notifications}" FontWeight="SemiBold" /><CheckBox x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding NotificationsEnabled}" automation:AutomationProperties.Name="{DynamicResource Settings.Notifications}" /></Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{DynamicResource Settings.TrayMenu}" Margin="0,0,0,8" />
                        <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.TrayShowTemperature}" /><CheckBox x:Name="TrayTemperatureToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding ShowTrayTemperature}" automation:AutomationProperties.Name="{DynamicResource Settings.TrayShowTemperature}" /></Grid>
                        <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.TrayShowOpen}" /><CheckBox x:Name="TrayOpenToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding ShowTrayOpen}" automation:AutomationProperties.Name="{DynamicResource Settings.TrayShowOpen}" /></Grid>
                        <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.TrayShowModeToggle}" /><CheckBox x:Name="TrayModeToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding ShowTrayModeToggle}" automation:AutomationProperties.Name="{DynamicResource Settings.TrayShowModeToggle}" /></Grid>
                        <Border Margin="0,10,0,0" Padding="12" CornerRadius="8" Background="{StaticResource RailBackgroundBrush}">
                            <StackPanel>
                                <Grid x:Name="TrayTemperaturePreviewEntry"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowTrayTemperature}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="GPU" FontWeight="SemiBold" /><TextBlock x:Name="TrayTemperaturePreviewText" Grid.Column="1" Text="{Binding TrayTemperaturePreview}" Foreground="{StaticResource ColdColorBrush}" FontWeight="SemiBold" /></Grid>
                                <TextBlock x:Name="TrayOpenPreviewEntry" Text="{DynamicResource Tray.Open}" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowTrayOpen}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <TextBlock x:Name="TrayModePreviewEntry" Text="{DynamicResource Tray.DisableMode}" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowTrayModeToggle}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <TextBlock x:Name="TrayExitPreviewEntry" Text="{DynamicResource Tray.Exit}" Margin="0,6,0,0" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Settings.TrayExitAlwaysVisible}" Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsPanelStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{DynamicResource Settings.Hardware}" Margin="0,0,0,10" />
                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource ColdColorBrush}" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding LightingDeviceName}" FontWeight="SemiBold" /><TextBlock Text="{Binding LightingHardwareStatus}" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><TextBlock Grid.Column="2" Text="LampArray" Foreground="{StaticResource SuccessColorBrush}" /></Grid>
                        <ComboBox x:Name="LightingDeviceSelector" Margin="30,10,0,8" MinHeight="32" ItemsSource="{Binding LightingDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedLightingDeviceId}" automation:AutomationProperties.Name="{DynamicResource Settings.PreferredLightingDevice}"><ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLightingDeviceSelectorVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                        <Button x:Name="OpenLightingTestButton" Margin="0,14,0,0" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                                Content="{DynamicResource Settings.OpenLightingTest}" Command="{Binding OpenLightingTestCommand}"
                                automation:AutomationProperties.Name="{DynamicResource Settings.OpenLightingTest}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
