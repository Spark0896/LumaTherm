<UserControl x:Class="LumaTherm.App.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:controls="clr-namespace:LumaTherm.App.Controls" xmlns:converters="clr-namespace:LumaTherm.App.Converters" xmlns:settings="clr-namespace:LumaTherm.Core.Settings;assembly=LumaTherm.Core" Background="Transparent" SizeChanged="SettingsView_SizeChanged">
    <UserControl.Resources>
        <converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" />
        <Style x:Key="SettingsPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}"><Setter Property="Padding" Value="20" /><Setter Property="Margin" Value="0,0,0,16" /></Style>
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /></Style>
        <Style x:Key="SubheadingStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,12" /></Style>
        <Style x:Key="TemperatureEditorStyle" TargetType="TextBox" BasedOn="{StaticResource EditorTextBoxStyle}"><Setter Property="Width" Value="74" /><Setter Property="HorizontalContentAlignment" Value="Right" /></Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="SettingsRoot" Margin="28,26,28,12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="1.1*" /><ColumnDefinition x:Name="ColumnGap" Width="16" /><ColumnDefinition x:Name="RightColumn" Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="3"><TextBlock Text="{DynamicResource Settings.Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Settings.Subtitle}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
                <StackPanel x:Name="LeftSettingsStack" Grid.Row="2">
                    <Border x:Name="ColorScalePanel" Style="{StaticResource SettingsPanelStyle}">
                        <StackPanel>
                            <TextBlock x:Name="ColorScaleHeading" Style="{StaticResource SectionHeadingStyle}" Text="{DynamicResource Settings.ColorScale}" />
                            <TextBlock Style="{StaticResource SubheadingStyle}" Text="{DynamicResource Settings.ColorScaleHint}" />
                            <controls:ThermalProfileEditor x:Name="ProfileEditorControl" DataContext="{Binding ProfileEditor}" />
                            <Border BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource Settings.SelectedPoint}" /><TextBlock Text="{Binding SelectedPointColorHex}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                                <TextBox x:Name="SelectedPointTemperatureEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}" Margin="12,0,0,0" automation:AutomationProperties.Name="{DynamicResource Settings.PointTemperature}" ><TextBox.Text><Binding Path="SelectedPointTemperature" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True"><Binding.ValidationRules><controls:NumericRangeValidationRule Minimum="0" Maximum="120" /></Binding.ValidationRules></Binding></TextBox.Text></TextBox>
                                <Button x:Name="SelectedPointColorButton" Grid.Column="2" Width="48" MinWidth="0" Height="36" Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" Padding="0" Background="{Binding SelectedPoint.Color, Converter={StaticResource RgbColorBrushConverter}}" BorderThickness="2" BorderBrush="{StaticResource MutedTextBrush}" Command="{Binding PickSelectedColorCommand}" ToolTip="{DynamicResource Settings.PointColor}" automation:AutomationProperties.Name="{DynamicResource Settings.PointColor}" />
                            </Grid>
                            <WrapPanel><Button x:Name="OpenLightingTestButton" HorizontalAlignment="Left" Margin="0,18,10,0" Content="{DynamicResource Settings.OpenLightingTest}" Command="{Binding OpenLightingTestCommand}" automation:AutomationProperties.Name="{DynamicResource Settings.OpenLightingTest}" ><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=SelectedPointTemperatureEditor, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding ElementName=SmoothingEditor, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button x:Name="ResetColorsButton" Style="{StaticResource ActionButtonStyle}" Margin="0,18,0,0" Content="{DynamicResource Settings.DefaultColors}" Command="{Binding ResetColorsCommand}" /></WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsPanelStyle}"><StackPanel><TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{DynamicResource Settings.SmoothingSeconds}" /><TextBlock Style="{StaticResource SubheadingStyle}" Text="{DynamicResource Settings.SmoothingHint}" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Slider x:Name="SmoothingSlider" Minimum="0.1" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding SmoothingSeconds}" automation:AutomationProperties.Name="{DynamicResource Settings.SmoothingSeconds}" /><TextBox x:Name="SmoothingEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}" Margin="12,0,0,0" automation:AutomationProperties.Name="{DynamicResource Settings.SmoothingSeconds}" ><TextBox.Text><Binding Path="SmoothingSeconds" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True"><Binding.ValidationRules><controls:NumericRangeValidationRule Minimum="0.1" Maximum="5" /></Binding.ValidationRules></Binding></TextBox.Text></TextBox></Grid></StackPanel></Border>
                    <Border Style="{StaticResource SettingsPanelStyle}"><StackPanel><TextBlock Style="{StaticResource SectionHeadingStyle}" Text="{DynamicResource Settings.TrayMenu}" />
                        <Grid Margin="0,14,0,8"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.TrayShowTemperature}" VerticalAlignment="Center" /><CheckBox x:Name="TrayTemperatureToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding ShowTrayTemperature}" automation:AutomationProperties.Name="{DynamicResource Settings.TrayShowTemperature}" /></Grid>
                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.TrayShowOpen}" VerticalAlignment="Center" /><CheckBox x:Name="TrayOpenToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding ShowTrayOpen}" automation:AutomationProperties.Name="{DynamicResource Settings.TrayShowOpen}" /></Grid>
                        <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.TrayShowModeToggle}" VerticalAlignment="Center" /><CheckBox x:Name="TrayModeToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding ShowTrayModeToggle}" automation:AutomationProperties.Name="{DynamicResource Settings.TrayShowModeToggle}" /></Grid>
                        <StackPanel Margin="0,12,0,0">
                            <Grid x:Name="TrayTemperaturePreviewEntry"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding ShowTrayTemperature}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style><TextBlock x:Name="TrayTemperaturePreviewText" Text="{Binding TrayTemperaturePreview}" Foreground="{StaticResource ColdColorBrush}" /></Grid>
                            <TextBlock x:Name="TrayOpenPreviewEntry" Text="{DynamicResource Tray.Open}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ShowTrayOpen}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock x:Name="TrayModePreviewEntry" Text="{DynamicResource Tray.DisableMode}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding ShowTrayModeToggle}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock x:Name="TrayExitPreviewEntry" Text="{DynamicResource Tray.Exit}" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" />
                            <TextBlock Text="{DynamicResource Settings.TrayExitAlwaysVisible}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel></Border>
                </StackPanel>
                <StackPanel x:Name="RightSettingsStack" Grid.Row="2" Grid.Column="2">
                    <Border x:Name="HardwarePanel" Style="{StaticResource SettingsPanelStyle}"><StackPanel><TextBlock Text="{DynamicResource Settings.Hardware}" Style="{StaticResource SectionHeadingStyle}" /><TextBlock Text="{Binding LightingDeviceName}" Margin="0,14,0,5" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding LightingHardwareStatus}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <ComboBox x:Name="LightingDeviceSelector" Margin="0,12,0,0" ItemsSource="{Binding LightingDevices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedLightingDeviceId}" automation:AutomationProperties.Name="{DynamicResource Settings.PreferredLightingDevice}"><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsLightingDeviceSelectorVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                        <Button x:Name="RefreshDevicesButton" Style="{StaticResource ActionButtonStyle}" Margin="0,14,0,0" HorizontalAlignment="Left" Content="{DynamicResource Settings.RefreshDevices}" Command="{Binding DiscoverLightingDevicesCommand}" />
                    </StackPanel></Border>
                    <Border Style="{StaticResource SettingsPanelStyle}"><StackPanel><TextBlock Text="{DynamicResource Settings.Application}" Style="{StaticResource SectionHeadingStyle}" />
                        <Grid Margin="0,16,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="{DynamicResource Settings.LaunchWithWindows}" /><TextBlock Text="{DynamicResource Settings.AutostartHint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><CheckBox x:Name="AutostartToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding IsAutostartEnabled}" Command="{Binding ApplyAutostartCommand}" automation:AutomationProperties.Name="{DynamicResource Settings.LaunchWithWindows}" /></Grid>
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="{DynamicResource Settings.MinimizeOnClose}" /><TextBlock Text="{DynamicResource Settings.MinimizeOnCloseHint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel><CheckBox x:Name="MinimizeToTrayToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding MinimizeToTray}" automation:AutomationProperties.Name="{DynamicResource Settings.MinimizeOnClose}" /></Grid>
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Settings.Notifications}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0" /><CheckBox x:Name="NotificationsToggle" Grid.Column="1" Style="{StaticResource ApplicationToggleStyle}" IsChecked="{Binding NotificationsEnabled}" automation:AutomationProperties.Name="{DynamicResource Settings.Notifications}" /></Grid>
                        <TextBlock Text="{DynamicResource Settings.Language}" Margin="0,0,0,8" /><ComboBox x:Name="LanguageSelector" SelectedValuePath="Tag" SelectedValue="{Binding SelectedLanguage}" automation:AutomationProperties.Name="{DynamicResource Settings.Language}"><ComboBoxItem Tag="{x:Static settings:AppLanguage.System}" Content="{DynamicResource Settings.LanguageSystem}" /><ComboBoxItem Tag="{x:Static settings:AppLanguage.English}" Content="English" /><ComboBoxItem Tag="{x:Static settings:AppLanguage.Russian}" Content="Русский" /></ComboBox>
                        <Button Style="{StaticResource ActionButtonStyle}" Margin="0,14,0,0" HorizontalAlignment="Left" Content="{DynamicResource Settings.WindowsStartup}" Command="{Binding OpenStartupSettingsCommand}" />
                    </StackPanel></Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource RailBackgroundBrush}" Padding="28,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{DynamicResource Settings.ApplyAfterSave}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /><TextBlock x:Name="ValidationText" Text="{Binding ValidationMessage}" Foreground="#FFADB2" FontSize="12" TextWrapping="Wrap" automation:AutomationProperties.Name="{Binding ValidationMessage}" automation:AutomationProperties.LiveSetting="Assertive" /></StackPanel>
                <StackPanel x:Name="EditorActions" Grid.Column="1" Orientation="Horizontal"><Button x:Name="ResetButton" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Content="{DynamicResource Settings.Reset}" Command="{Binding ResetDefaultsCommand}" automation:AutomationProperties.Name="{DynamicResource Settings.Reset}" /><Button x:Name="SaveButton" Content="{DynamicResource Settings.Save}" Command="{Binding SaveCommand}" automation:AutomationProperties.Name="{DynamicResource Accessibility.SaveSettings}" ><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=SelectedPointTemperatureEditor, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger><DataTrigger Binding="{Binding ElementName=SmoothingEditor, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
