<Window x:Class="LumaTherm.App.Views.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:LumaTherm.App.Converters" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
 Title="{DynamicResource ColorPicker.Title}" Width="470" Height="550" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}" ShowInTaskbar="False" Foreground="{StaticResource PrimaryTextBrush}">
    <Window.Resources><converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" /></Window.Resources>
    <Border BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition /></Grid.RowDefinitions>
        <Border Background="{StaticResource RailBackgroundBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="18,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Width="24" Height="24" Source="{StaticResource LogoDrawingImage}"/><TextBlock Text="LumaTherm" Foreground="#B5E2FF" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel><Button Grid.Column="1" Style="{StaticResource WindowButtonStyle}" Click="Close_Click" automation:AutomationProperties.Name="{DynamicResource Accessibility.CloseWindow}"><Path Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Data="M1,1 L9,9 M9,1 L1,9"/></Button></Grid></Border>
        <Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{DynamicResource ColorPicker.Title}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource ColorPicker.Hint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,18" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Row="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Height="64" CornerRadius="8" Background="{Binding Color, Converter={StaticResource RgbColorBrushConverter}}" BorderBrush="#637889" BorderThickness="1" /><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="HEX" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /><TextBox x:Name="HexEditor" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" MaxLength="7" automation:AutomationProperties.Name="HEX" /></StackPanel></Grid>
            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,16,0,8"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="29" Height="29" MinWidth="0" MinHeight="0" Margin="0,0,4,5" Style="{StaticResource ActionButtonStyle}" Padding="0" Background="{Binding Converter={StaticResource RgbColorBrushConverter}}" BorderBrush="#637889" Click="Preset_Click" ToolTip="{Binding}" automation:AutomationProperties.Name="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="R" VerticalAlignment="Center" Foreground="#FF8998" /><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding Red}" automation:AutomationProperties.Name="{DynamicResource ColorPicker.Red}" /><TextBlock Grid.Column="2" Text="{Binding Red}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="G" VerticalAlignment="Center" Foreground="#61DDA6" /><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding Green}" automation:AutomationProperties.Name="{DynamicResource ColorPicker.Green}" /><TextBlock Grid.Column="2" Text="{Binding Green}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions><TextBlock Text="B" VerticalAlignment="Center" Foreground="#47B4FF" /><Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding Blue}" automation:AutomationProperties.Name="{DynamicResource ColorPicker.Blue}" /><TextBlock Grid.Column="2" Text="{Binding Blue}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid>
            <TextBlock Text="{DynamicResource ColorPicker.InvalidHex}" FontSize="12" Foreground="#FFADB2" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource TestWindow.Cancel}" IsCancel="True" Margin="0,0,10,0" /><Button x:Name="ApplyColorButton" Style="{StaticResource PrimaryActionButtonStyle}" Content="{DynamicResource TestWindow.Apply}" IsDefault="True" IsEnabled="{Binding IsValid}" Click="Apply_Click" /></StackPanel>
    </Grid>
</Grid></Border>
</Window>
