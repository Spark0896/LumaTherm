<Window x:Class="LumaTherm.App.Views.LightingTestWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:controls="clr-namespace:LumaTherm.App.Controls" xmlns:converters="clr-namespace:LumaTherm.App.Converters" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="{DynamicResource TestWindow.Title}" Width="860" Height="780" MinWidth="700" MinHeight="580" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource WindowBackgroundBrush}" Icon="/LumaTherm.App;component/Assets/LumaTherm.ico" ShowInTaskbar="False" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Window.Resources><converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" /><Style x:Key="TestPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}"><Setter Property="Padding" Value="20" /></Style><Style x:Key="TemperatureEditorStyle" TargetType="TextBox" BasedOn="{StaticResource EditorTextBoxStyle}"><Setter Property="Width" Value="76" /><Setter Property="HorizontalContentAlignment" Value="Right" /></Style></Window.Resources>
    <Border BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border Background="{StaticResource RailBackgroundBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="18,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Width="27" Height="27" Source="{StaticResource LogoDrawingImage}" /><TextBlock Text="LumaTherm" Foreground="#B5E2FF" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel><Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource WindowButtonStyle}" Click="CloseButton_Click" automation:AutomationProperties.Name="{DynamicResource Accessibility.CloseWindow}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="10" Height="10" Stretch="Uniform" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.3" Data="M1,1 L9,9 M9,1 L1,9" /></Button></Grid></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24,26,24">
            <TextBlock Text="{DynamicResource TestWindow.Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource TestWindow.Subtitle}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,22" TextWrapping="Wrap" />
            <Border Style="{StaticResource TestPanelStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource TestWindow.Temperature}" FontWeight="SemiBold" FontSize="14" /><TextBlock x:Name="TestTemperatureValue" Text="{Binding TestTemperature, StringFormat={}{0:0.#}°C}" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <Slider x:Name="TestTemperatureSlider" Background="{Binding PreviewGradient}" Minimum="0" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Value="{Binding TestTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="{DynamicResource TestWindow.Temperature}" />
                <Grid Margin="12,0"><TextBlock Text="0°C" FontSize="12" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="120°C" FontSize="12" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" /></Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource TestPanelStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{DynamicResource TestWindow.Preview}" FontSize="14" FontWeight="SemiBold" />
                <Border Background="#111C24" CornerRadius="8" Margin="0,14,0,14" Padding="18"><UniformGrid Rows="1" Columns="12" Height="48">
                    <Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><Border Margin="3" CornerRadius="5" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" />
                </UniformGrid></Border>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource TestWindow.CurrentColor}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" /><Border x:Name="PreviewColor" Grid.Column="1" Width="28" Height="28" CornerRadius="14" Margin="0,0,12,0" Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" /><TextBlock Grid.Column="2" Text="{Binding PreviewHex}" VerticalAlignment="Center" /></Grid>
                <TextBlock Text="{DynamicResource TestWindow.DeviceHint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,14,0,0" />
            </StackPanel></Border>
            <Border Style="{StaticResource TestPanelStyle}"><StackPanel><TextBlock Text="{DynamicResource TestWindow.Profile}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource TestWindow.ProfileHint}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,10" /><controls:ThermalProfileEditor x:Name="ProfileEditorControl" DataContext="{Binding Editor}" />
                <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource TestWindow.SelectedPoint}" /><TextBlock Text="{Binding SelectedPointColorHex}" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" /></StackPanel><TextBox x:Name="SelectedPointTemperatureEditor" Grid.Column="1" Style="{StaticResource TemperatureEditorStyle}" automation:AutomationProperties.Name="{DynamicResource TestWindow.PointTemperature}" ><TextBox.Text><Binding Path="SelectedPointTemperature" UpdateSourceTrigger="PropertyChanged" ValidatesOnExceptions="True"><Binding.ValidationRules><controls:NumericRangeValidationRule Minimum="0" Maximum="120" /></Binding.ValidationRules></Binding></TextBox.Text></TextBox><Button x:Name="SelectedPointColorButton" Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Width="48" MinWidth="0" Padding="0" Height="36" Margin="10,0,0,0" Background="{Binding SelectedPoint.Color, Converter={StaticResource RgbColorBrushConverter}}" Command="{Binding PickSelectedColorCommand}" automation:AutomationProperties.Name="{DynamicResource TestWindow.PointColor}" /></Grid>
            </StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource RailBackgroundBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0" Padding="26,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ErrorMessage}" Foreground="#FFADB2" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" automation:AutomationProperties.LiveSetting="Assertive" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource TestWindow.Cancel}" Margin="0,0,10,0" Click="CancelButton_Click" automation:AutomationProperties.Name="{DynamicResource TestWindow.Cancel}" /><Button x:Name="ApplyButton" Content="{DynamicResource TestWindow.Apply}" Click="ApplyButton_Click" automation:AutomationProperties.Name="{DynamicResource TestWindow.Apply}" ><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding ElementName=SelectedPointTemperatureEditor, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Grid></Border>
    </Grid></Border>
</Window>
