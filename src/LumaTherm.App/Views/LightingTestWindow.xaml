<Window x:Class="LumaTherm.App.Views.LightingTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:LumaTherm.App.Controls"
        xmlns:converters="clr-namespace:LumaTherm.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource TestWindow.Title}"
        Width="780" Height="650" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="/LumaTherm.App;component/Assets/LumaTherm.ico"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" />
        <Style x:Key="TestPanelStyle" TargetType="Border" BasedOn="{StaticResource PanelStyle}">
            <Setter Property="Padding" Value="20" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionChrome" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionChrome" Property="Opacity" Value="0.88" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionChrome" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ActionChrome" Property="BorderBrush" Value="{StaticResource ColdColorBrush}" /><Setter TargetName="ActionChrome" Property="BorderThickness" Value="2" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionChrome" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Foreground" Value="#FF111419" />
            <Setter Property="Background" Value="{StaticResource ColdColorBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ColdColorBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1AFFFFFF" BorderThickness="1" Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#DB161A1F" BorderBrush="{StaticResource SubtleLineBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource TestWindow.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="116" Height="34" Padding="12,0" Click="CloseButton_Click"
                            Content="{DynamicResource Accessibility.CloseWindow}"
                            automation:AutomationProperties.Name="{DynamicResource Accessibility.CloseWindow}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,18">
                    <Border Style="{StaticResource TestPanelStyle}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{DynamicResource TestWindow.Temperature}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="TestTemperatureValue" Margin="0,7,0,14" FontSize="30" FontWeight="SemiBold"
                                           Foreground="{StaticResource ColdColorBrush}"
                                           Text="{Binding TestTemperature, StringFormat={}{0:F0} °C}" />
                                <Slider x:Name="TestTemperatureSlider" Minimum="0" Maximum="120" TickFrequency="1"
                                        IsSnapToTickEnabled="False" IsMoveToPointEnabled="True"
                                        Value="{Binding TestTemperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        automation:AutomationProperties.Name="{DynamicResource TestWindow.Temperature}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource TestWindow.Preview}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9" />
                                <Border x:Name="PreviewColor" Height="104" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1"
                                        Background="{Binding PreviewColor, Converter={StaticResource RgbColorBrushConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource TestPanelStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource TestWindow.Profile}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource TestWindow.ProfileHint}" Margin="0,4,0,16" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <controls:ThermalProfileEditor x:Name="ProfileEditorControl" Height="210" DataContext="{Binding Editor}" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ErrorText" Margin="4,12,4,0" Foreground="{StaticResource HotColorBrush}"
                               Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                               automation:AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#DB161A1F" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="24,0">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                            Content="{DynamicResource TestWindow.Cancel}" Click="CancelButton_Click"
                            automation:AutomationProperties.Name="{DynamicResource TestWindow.Cancel}" />
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource TestWindow.Apply}" Click="ApplyButton_Click"
                            automation:AutomationProperties.Name="{DynamicResource TestWindow.Apply}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
