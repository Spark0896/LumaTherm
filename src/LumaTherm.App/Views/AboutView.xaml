<UserControl x:Class="LumaTherm.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28" MaxWidth="900" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="{DynamicResource About.Title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource About.Subtitle}" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="LumaTherm" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource About.Description}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{DynamicResource About.OpenSource}" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <TextBlock Text="{DynamicResource About.Version}" />
                        <TextBlock Text=": " />
                        <TextBlock Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource About.Repository}" />
                        <TextBlock Text=": " />
                        <TextBlock Text="{Binding RepositoryUrl, Mode=OneWay}" Foreground="{DynamicResource ColdColorBrush}" />
                    </StackPanel>
                    <Button x:Name="RepositoryButton" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenRepositoryCommand}" Margin="0,14,0,0" HorizontalAlignment="Left"
                            Content="{DynamicResource About.OpenGitHub}" automation:AutomationProperties.Name="{DynamicResource About.OpenGitHub}" />
                    <Separator Margin="0,22,0,18" Background="{DynamicResource SubtleLineBrush}" />
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" automation:AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding AvailableVersion, Mode=OneWay}" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{DynamicResource ColdColorBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="CheckForUpdatesButton" Style="{StaticResource PrimaryActionButtonStyle}" Command="{Binding CheckForUpdatesCommand}"
                                Content="{DynamicResource Update.CheckAction}" automation:AutomationProperties.Name="{DynamicResource Update.CheckAction}" />
                        <Button x:Name="OpenReleaseButton" Style="{StaticResource ActionButtonStyle}" Command="{Binding OpenReleaseCommand}" Margin="10,0,0,0"
                                Content="{DynamicResource Update.OpenRelease}" automation:AutomationProperties.Name="{DynamicResource Update.OpenRelease}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
