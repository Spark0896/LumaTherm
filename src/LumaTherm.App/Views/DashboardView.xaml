<UserControl x:Class="LumaTherm.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:controls="clr-namespace:LumaTherm.App.Controls" xmlns:converters="clr-namespace:LumaTherm.App.Converters" Background="Transparent" SizeChanged="OnDashboardSizeChanged">
    <UserControl.Resources><converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" /><converters:RgbColorHexConverter x:Key="RgbColorHexConverter" /></UserControl.Resources>
    <ScrollViewer x:Name="DashboardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="LayoutRoot" Margin="28,26,28,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="{DynamicResource Dashboard.Title}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Dashboard.Subtitle}" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
            <Grid x:Name="TopGrid" Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="TopRingColumn" Width="1.05*" /><ColumnDefinition x:Name="TopGapColumn" Width="16" /><ColumnDefinition x:Name="TopProfileColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition x:Name="TopFirstRow" Height="260" /><RowDefinition x:Name="TopCompactGapRow" Height="0" /><RowDefinition x:Name="TopSecondRow" Height="0" /></Grid.RowDefinitions>
                <Border x:Name="RingPanel" Style="{StaticResource PanelStyle}" Padding="22">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="148" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Dashboard.GpuTemperature}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentTemperatureText" Text="{Binding TemperatureText}" FontSize="52" FontWeight="SemiBold" Margin="0,9,0,10" />
                            <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#334351" /><Style.Triggers><DataTrigger Binding="{Binding IsHealthy}" Value="True"><Setter Property="Background" Value="#23493D" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock x:Name="ModeStatusText" Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsHealthy}" Value="True"><Setter Property="Foreground" Value="#98EBC6" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
                            <TextBlock Text="{Binding GpuName}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" />
                            <TextBlock Text="{Binding SensorSource}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" FontSize="12" />
                        </StackPanel>
                        <controls:TemperatureRing x:Name="TemperatureRing" Grid.Column="1" Width="148" Height="148" VerticalAlignment="Center" Temperature="{Binding CurrentTemperature}" Minimum="{Binding Profile.ColdTemperature}" Maximum="{Binding Profile.HotTemperature}" DisplayColor="{Binding DisplayColor}" />
                    </Grid>
                </Border>
                <Border x:Name="MonitorPanel" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Dashboard.History}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <controls:TemperatureSparkline x:Name="HistorySparkline" Grid.Row="2" ItemsSource="{Binding History}" Profile="{Binding Profile}" automation:AutomationProperties.Name="{DynamicResource Dashboard.History}" />
                        <Grid Grid.Row="3" Margin="30,8,0,0"><TextBlock Text="{DynamicResource Dashboard.SixtySecondsAgo}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{DynamicResource Dashboard.Now}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" /></Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="BottomGrid" Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="MonitorColumn" Width="1.05*" /><ColumnDefinition x:Name="BottomGapColumn" Width="16" /><ColumnDefinition x:Name="BehaviorColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition x:Name="BottomFirstRow" Height="240" /><RowDefinition x:Name="BottomCompactGapRow" Height="0" /><RowDefinition x:Name="BottomSecondRow" Height="0" /></Grid.RowDefinitions>
                <Border x:Name="BehaviorPanel" Style="{StaticResource PanelStyle}" Padding="20">
                    <StackPanel>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Dashboard.ActiveDevice}" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="{Binding LightingDeviceName}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" MinWidth="0" Style="{StaticResource ActionButtonStyle}" Padding="10,6" Content="{DynamicResource Dashboard.Manage}" Command="{Binding ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" /></Grid>
                        <Border BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0" Margin="0,17,0,14" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="{DynamicResource Dashboard.ThermalSync}" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="{DynamicResource Dashboard.Subtitle}" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                            <controls:AuthoritativeToggleButton x:Name="ModeToggle" Grid.Column="1" Width="44" Height="28" Command="{Binding ToggleModeCommand}" IsChecked="{Binding IsModeEnabled, Mode=OneWay}" automation:AutomationProperties.Name="{DynamicResource Accessibility.ToggleThermalSync}" FocusVisualStyle="{StaticResource KeyboardFocusStyle}">
                                <controls:AuthoritativeToggleButton.Template><ControlTemplate TargetType="controls:AuthoritativeToggleButton"><Border x:Name="SwitchTrack" Height="24" CornerRadius="12" Padding="3" Background="#50606D"><Ellipse x:Name="SwitchThumb" Width="18" Height="18" Fill="#EEF6FD" HorizontalAlignment="Left" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource ColdColorBrush}" /><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers></ControlTemplate></controls:AuthoritativeToggleButton.Template>
                            </controls:AuthoritativeToggleButton>
                        </Grid>
                        <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Dashboard.Smoothing}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding SmoothingText}" Foreground="{StaticResource ColdColorBrush}" FontSize="12" /></Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="ProfilePanel" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Dashboard.ProfileTitle}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <controls:ThermalGradientBar x:Name="ProfileGradientBar" Grid.Row="1" Height="74" Profile="{Binding Profile}" CurrentTemperature="{Binding CurrentTemperature}" VerticalAlignment="Center" />
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="18" Height="18" Fill="{Binding DisplayColor, Converter={StaticResource RgbColorBrushConverter}}" Margin="0,0,8,0" /><TextBlock x:Name="CurrentColorText" Text="{Binding CurrentColorHex}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><Button Grid.Column="1" Style="{StaticResource ActionButtonStyle}" MinWidth="0" Content="{DynamicResource Dashboard.EditProfile}" Command="{Binding ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" /></Grid>
                        <TextBlock Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,6" x:Name="ProfilePointsSummaryText" Text="{Binding ProfileSummary}" ToolTip="{Binding ProfileSummary}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
