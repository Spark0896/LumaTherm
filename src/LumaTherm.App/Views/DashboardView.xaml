<UserControl x:Class="LumaTherm.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" xmlns:controls="clr-namespace:LumaTherm.App.Controls" xmlns:converters="clr-namespace:LumaTherm.App.Converters" Background="Transparent" SizeChanged="OnDashboardSizeChanged">
    <UserControl.Resources>
        <converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" />
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>
    <ScrollViewer x:Name="DashboardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="LayoutRoot" Margin="28,26,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Dashboard.Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,18" />
            <Border x:Name="BehaviorPanel" Grid.Row="1" Style="{StaticResource PanelStyle}" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{DynamicResource Dashboard.ThermalSync}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock x:Name="ModeStatusText" Text="{Binding LightingStatusText}" Margin="0,5,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessColorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding LightingDetails}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,5,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LightingDetails}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Button Style="{StaticResource ActionButtonStyle}" MinWidth="0" Margin="0,0,14,0"
                                Content="{DynamicResource Settings.WindowsLighting}"
                                Command="{Binding SettingsDataContext.OpenLightingSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Visibility="{Binding ShowLightingHelp, Converter={StaticResource VisibleWhenTrue}}" />
                        <controls:AuthoritativeToggleButton x:Name="ModeToggle" Style="{StaticResource ApplicationToggleStyle}"
                                Command="{Binding ToggleModeCommand}" IsChecked="{Binding IsModeEnabled, Mode=OneWay}"
                                automation:AutomationProperties.Name="{DynamicResource Accessibility.ToggleThermalSync}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="TopGrid" Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="TopRingColumn" Width="1.05*" /><ColumnDefinition x:Name="TopGapColumn" Width="16" /><ColumnDefinition x:Name="TopProfileColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition x:Name="TopFirstRow" Height="260" /><RowDefinition x:Name="TopCompactGapRow" Height="0" /><RowDefinition x:Name="TopSecondRow" Height="0" /></Grid.RowDefinitions>
                <Border x:Name="RingPanel" Style="{StaticResource PanelStyle}" Padding="22">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="148" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource Dashboard.GpuTemperature}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentTemperatureText" Text="{Binding TemperatureText}" FontSize="52" FontWeight="SemiBold" Margin="0,9,0,10" />
                            <TextBlock Text="{Binding GpuName}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" />
                            <TextBlock Text="{Binding SensorSource}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" FontSize="12" />
                        </StackPanel>
                        <controls:TemperatureRing x:Name="TemperatureRing" Grid.Column="1" Width="148" Height="148" VerticalAlignment="Center" Temperature="{Binding CurrentTemperature}" Minimum="{Binding Profile.ColdTemperature}" Maximum="{Binding Profile.HotTemperature}" DisplayColor="{Binding DisplayColor}" />
                    </Grid>
                </Border>
                <Border x:Name="MonitorPanel" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Dashboard.History}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <controls:TemperatureSparkline x:Name="HistorySparkline" Grid.Row="2" ItemsSource="{Binding History}" WindowEnd="{Binding HistoryEnd}" Profile="{Binding Profile}" automation:AutomationProperties.Name="{DynamicResource Dashboard.History}" />
                        <Grid Grid.Row="3" Margin="30,8,0,0"><TextBlock Text="{DynamicResource Dashboard.SixtySecondsAgo}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{DynamicResource Dashboard.Now}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" /></Grid>
                    </Grid>
                </Border>
            </Grid>
            <Grid x:Name="BottomGrid" Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="MonitorColumn" Width="1.05*" /><ColumnDefinition x:Name="BottomGapColumn" Width="16" /><ColumnDefinition x:Name="BehaviorColumn" Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition x:Name="BottomFirstRow" Height="240" /><RowDefinition x:Name="BottomCompactGapRow" Height="0" /><RowDefinition x:Name="BottomSecondRow" Height="0" /></Grid.RowDefinitions>
                <Border x:Name="HardwarePanel" Style="{StaticResource PanelStyle}" Padding="18">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource Dashboard.ActiveDevice}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Text="{Binding LightingDeviceName}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="0" Style="{StaticResource ActionButtonStyle}" Padding="10,6"
                                    Content="{DynamicResource Dashboard.Manage}" Command="{Binding ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Grid>
                        <Border BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Dashboard.SentColor}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="14" Height="14" Fill="{Binding SentColor, Converter={StaticResource RgbColorBrushConverter}}" Margin="0,0,8,0" />
                                <TextBlock x:Name="CurrentColorText" Text="{Binding CurrentColorHex}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource Dashboard.Smoothing}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding SmoothingText}" Foreground="{StaticResource ColdColorBrush}" FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border x:Name="ProfilePanel" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Dashboard.ProfileTitle}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <controls:ThermalGradientBar x:Name="ProfileGradientBar" Grid.Row="1" Height="60" Profile="{Binding Profile}" CurrentTemperature="{Binding CurrentTemperature}" VerticalAlignment="Center" />
                        <Button Grid.Row="2" HorizontalAlignment="Right" Style="{StaticResource ActionButtonStyle}" MinWidth="0"
                                Content="{DynamicResource Dashboard.EditProfile}" Command="{Binding ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,1" x:Name="ProfilePointsSummaryText" Text="{Binding ProfileSummary}" ToolTip="{Binding ProfileSummary}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
