<UserControl x:Class="LumaTherm.App.Controls.ThermalProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:LumaTherm.App.Converters"
             xmlns:local="clr-namespace:LumaTherm.App.Controls"
             Background="Transparent"
             Focusable="False"
             MinHeight="92"
             automation:AutomationProperties.Name="Thermal profile temperature scale">
    <UserControl.Resources>
        <converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" />
        <local:TemperatureToCanvasLeftConverter x:Key="TemperatureToCanvasLeftConverter" />
        <Style x:Key="ThermalPointMarkerStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="automation:AutomationProperties.ItemStatus" Value="" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="-3" BorderBrush="{StaticResource ColdColorBrush}"
                                            BorderThickness="2" CornerRadius="16" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="MarkerHalo" Width="22" Height="22"
                                     Fill="#FF171B20" Stroke="#FFF1F8FB" StrokeThickness="2" />
                            <Ellipse Width="12" Height="12"
                                     Fill="{Binding Color, Converter={StaticResource RgbColorBrushConverter}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MarkerHalo" Property="Stroke" Value="{StaticResource ColdColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MarkerHalo" Property="Stroke" Value="{StaticResource ColdColorBrush}" />
                                <Setter TargetName="MarkerHalo" Property="StrokeThickness" Value="3" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="MarkerHalo" Property="Stroke" Value="{StaticResource ColdColorBrush}" />
                                <Setter TargetName="MarkerHalo" Property="StrokeThickness" Value="3" />
                                <Setter Property="automation:AutomationProperties.ItemStatus" Value="Selected" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="GradientTrack" Grid.Row="0" Height="12" VerticalAlignment="Center"
                CornerRadius="6" Background="#FF363D43"
                MouseLeftButtonDown="GradientTrack_MouseLeftButtonDown" />
        <ItemsControl x:Name="PointMarkers" Grid.Row="0" ItemsSource="{Binding Points}"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="False" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Top" Value="1" />
                    <Setter Property="Canvas.Left">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource TemperatureToCanvasLeftConverter}">
                                <Binding Path="Temperature" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ThermalPointMarkerStyle}"
                            automation:AutomationProperties.Name="{Binding Temperature, StringFormat=Temperature {0:0.#} degrees Celsius}"
                            PreviewKeyDown="PointMarker_PreviewKeyDown"
                            PreviewMouseLeftButtonDown="PointMarker_MouseLeftButtonDown"
                            MouseMove="PointMarker_MouseMove"
                            PreviewMouseLeftButtonUp="PointMarker_MouseLeftButtonUp"
                            LostMouseCapture="PointMarker_LostMouseCapture" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="1" HorizontalAlignment="Left" Text="0 °C" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Grid.Row="1" HorizontalAlignment="Right" Text="120 °C" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                   Text="Double-click to add · Drag or use arrow keys · Delete to remove" />
    </Grid>
</UserControl>
