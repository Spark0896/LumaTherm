<UserControl x:Class="LumaTherm.App.Controls.ThermalProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:converters="clr-namespace:LumaTherm.App.Converters"
             xmlns:local="clr-namespace:LumaTherm.App.Controls"
             Background="Transparent"
             Focusable="False"
             MinHeight="92"
             automation:AutomationProperties.Name="{DynamicResource Accessibility.ThermalProfile}">
    <UserControl.Resources>
        <converters:RgbColorBrushConverter x:Key="RgbColorBrushConverter" />
        <local:TemperatureToCanvasLeftConverter x:Key="TemperatureToCanvasLeftConverter" />
        <Style x:Key="ThermalPointMarkerStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="automation:AutomationProperties.ItemStatus" Value="" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Border Margin="-3" BorderBrush="{StaticResource ColdColorBrush}"
                                            BorderThickness="2" CornerRadius="16" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="MarkerHalo" Width="22" Height="22"
                                     Fill="#FF171B20" Stroke="#FFF1F8FB" StrokeThickness="2" />
                            <Ellipse Width="12" Height="12"
                                     Fill="{Binding Color, Converter={StaticResource RgbColorBrushConverter}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MarkerHalo" Property="Stroke" Value="{StaticResource ColdColorBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MarkerHalo" Property="Stroke" Value="{StaticResource ColdColorBrush}" />
                                <Setter TargetName="MarkerHalo" Property="StrokeThickness" Value="3" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="MarkerHalo" Property="Stroke" Value="{StaticResource ColdColorBrush}" />
                                <Setter TargetName="MarkerHalo" Property="StrokeThickness" Value="3" />
                                <Setter Property="automation:AutomationProperties.ItemStatus" Value="{DynamicResource Accessibility.Selected}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="GradientTrack" Grid.Row="0" Height="12" VerticalAlignment="Center"
                CornerRadius="6" Background="#FF363D43"
                MouseLeftButtonDown="GradientTrack_MouseLeftButtonDown" />
        <ItemsControl x:Name="PointMarkers" Grid.Row="0" ItemsSource="{Binding Points}"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="False" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Top" Value="1" />
                    <Setter Property="Canvas.Left">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource TemperatureToCanvasLeftConverter}">
                                <Binding Path="Temperature" />
                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource ThermalPointMarkerStyle}"
                            automation:AutomationProperties.Name="{Binding Temperature, StringFormat={}{0:0.#} °C}"
                            PreviewKeyDown="PointMarker_PreviewKeyDown"
                            PreviewMouseLeftButtonDown="PointMarker_MouseLeftButtonDown"
                            MouseMove="PointMarker_MouseMove"
                            PreviewMouseLeftButtonUp="PointMarker_MouseLeftButtonUp"
                            LostMouseCapture="PointMarker_LostMouseCapture" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Grid.Row="1" HorizontalAlignment="Left" Text="0 °C" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Grid.Row="1" HorizontalAlignment="Right" Text="120 °C" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Grid.Row="2" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                   Text="{DynamicResource ProfileEditor.Instructions}" TextWrapping="Wrap" />
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Points}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Button Margin="0,0,6,6" Click="PointList_Click" automation:AutomationProperties.Name="{Binding Temperature, StringFormat={}{0:0.#} °C}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="8,6" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource ColdColorBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    <StackPanel Orientation="Horizontal"><Ellipse Width="14" Height="14" Margin="0,0,7,0" Fill="{Binding Color, Converter={StaticResource RgbColorBrushConverter}}" /><TextBlock Text="{Binding Temperature, StringFormat={}{0:0.#}°C}" FontSize="12" /></StackPanel>
                </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="AddPointButton" Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource ProfileEditor.Add}" MinWidth="0" Click="AddPoint_Click" /><Button x:Name="RemovePointButton" Style="{StaticResource ActionButtonStyle}" Content="{DynamicResource ProfileEditor.Remove}" MinWidth="0" Margin="8,0,0,0" Click="RemovePoint_Click" /></StackPanel>
    </Grid>
</UserControl>
