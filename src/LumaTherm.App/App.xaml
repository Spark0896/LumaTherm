<Application x:Class="LumaTherm.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/LogoGeometry.xaml" />
                <ResourceDictionary Source="Resources/Strings.en-US.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="WindowBackground">#171B20</Color>
            <Color x:Key="RailBackground">#111419</Color>
            <Color x:Key="PanelBackground">#20252B</Color>
            <Color x:Key="PanelSecondary">#1B2025</Color>
            <Color x:Key="PrimaryText">#EEF4F8</Color>
            <Color x:Key="SecondaryText">#A9B5BD</Color>
            <Color x:Key="MutedText">#7E8994</Color>
            <Color x:Key="ColdColor">#50C8FF</Color>
            <Color x:Key="WarmColor">#FFC64A</Color>
            <Color x:Key="HotColor">#FF565D</Color>
            <Color x:Key="SuccessColor">#55D69C</Color>

            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackground}" po:Freeze="True" />
            <SolidColorBrush x:Key="RailBackgroundBrush" Color="{StaticResource RailBackground}" po:Freeze="True" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackground}" po:Freeze="True" />
            <SolidColorBrush x:Key="PanelSecondaryBrush" Color="{StaticResource PanelSecondary}" po:Freeze="True" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}" po:Freeze="True" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}" po:Freeze="True" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}" po:Freeze="True" />
            <SolidColorBrush x:Key="ColdColorBrush" Color="{StaticResource ColdColor}" po:Freeze="True" />
            <SolidColorBrush x:Key="WarmColorBrush" Color="{StaticResource WarmColor}" po:Freeze="True" />
            <SolidColorBrush x:Key="HotColorBrush" Color="{StaticResource HotColor}" po:Freeze="True" />
            <SolidColorBrush x:Key="SuccessColorBrush" Color="{StaticResource SuccessColor}" po:Freeze="True" />
            <SolidColorBrush x:Key="SubtleLineBrush" Color="#13FFFFFF" po:Freeze="True" />
            <SolidColorBrush x:Key="IconIdleBrush" Color="#66727C" po:Freeze="True" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>
            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SubtleLineBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="45" />
                <Setter Property="Height" Value="43" />
                <Setter Property="Foreground" Value="{StaticResource IconIdleBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FocusVisualStyle">
                    <Setter.Value>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Border BorderBrush="{StaticResource ColdColorBrush}" BorderThickness="2" CornerRadius="10" Margin="-2" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PanelSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="#A9B5BD" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#252C32" />
                                    <Setter Property="Foreground" Value="{StaticResource ColdColorBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="WindowButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
