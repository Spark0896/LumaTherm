<Window x:Class="LumaTherm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:LumaTherm.App.Views"
        Title="LumaTherm"
        Width="1180" Height="720" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        Icon="Assets/LumaTherm.ico">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#1AFFFFFF" BorderThickness="1" Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RailBackgroundBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="0,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="38" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Image Width="40" Height="40" Source="{StaticResource LogoDrawingImage}" automation:AutomationProperties.Name="{DynamicResource Accessibility.Logo}" />
                    <StackPanel Grid.Row="2">
                        <Button x:Name="HomeButton" Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ShowDashboardCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Foreground="{StaticResource ColdColorBrush}" Background="#20272D"
                                automation:AutomationProperties.Name="{DynamicResource Nav.Home}" automation:AutomationProperties.ItemStatus="{DynamicResource Accessibility.Selected}">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" Margin="0,7,0,0"
                                Command="{Binding ShowSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                automation:AutomationProperties.Name="{DynamicResource Nav.Settings}">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                    <Border x:Name="HomeSelectionIndicator" Grid.Row="2" Width="3" Height="24"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0"
                            Background="{StaticResource ColdColorBrush}" CornerRadius="0,3,3,0" Panel.ZIndex="2">
                        <Border.Effect>
                            <DropShadowEffect Color="#50C8FF" BlurRadius="12" ShadowDepth="0" Opacity="1" />
                        </Border.Effect>
                    </Border>
                    <Border x:Name="SettingsSelectionIndicator" Grid.Row="2" Width="3" Height="24"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,60,0,0"
                            Background="{StaticResource ColdColorBrush}" CornerRadius="0,3,3,0" Panel.ZIndex="2" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#50C8FF" BlurRadius="12" ShadowDepth="0" Opacity="1" />
                        </Border.Effect>
                    </Border>
                    <Button x:Name="AboutButton" Grid.Row="4" Style="{StaticResource IconButtonStyle}"
                            Command="{Binding ShowAboutCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            automation:AutomationProperties.Name="{DynamicResource Nav.About}">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Border x:Name="AboutSelectionIndicator" Grid.Row="4" Width="3" Height="24"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{StaticResource ColdColorBrush}" CornerRadius="0,3,3,0" Panel.ZIndex="2" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#50C8FF" BlurRadius="12" ShadowDepth="0" Opacity="1" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="WorkspaceSurface" Grid.Column="1" SizeChanged="WorkspaceSurface_SizeChanged">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B2025" Offset="0" />
                        <GradientStop Color="#15191D" Offset="0.65" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#DB161A1F" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,0,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LumaTherm" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource App.Description}" Margin="10,1,0,0" FontSize="11" Foreground="#6F7A84" VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="33" Padding="11,0" Background="{StaticResource PanelSecondaryBrush}" BorderBrush="{StaticResource SubtleLineBrush}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DeviceStatusDot" Width="7" Height="7" Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource SuccessColorBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLightingDevice}" Value="False">
                                                    <Setter Property="Fill" Value="{StaticResource IconIdleBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding LightingDeviceName}" FontSize="11" Foreground="#A7B1B9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="7,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="MinimizeButton" Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click" automation:AutomationProperties.Name="{DynamicResource Accessibility.MinimizeWindow}">
                                <TextBlock x:Name="MinimizeButtonContent" Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_Click" automation:AutomationProperties.Name="{DynamicResource Accessibility.MaximizeWindow}">
                                <TextBlock x:Name="MaximizeButtonContent" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                            <Button x:Name="CloseButton" Style="{StaticResource WindowButtonStyle}" Click="CloseButton_Click" automation:AutomationProperties.Name="{DynamicResource Accessibility.CloseWindow}">
                                <TextBlock x:Name="CloseButtonContent" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <views:DashboardView x:Name="DashboardContent" />
                    <views:SettingsView x:Name="SettingsContent" Visibility="Collapsed"
                                        DataContext="{Binding SettingsDataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <views:AboutView x:Name="AboutContent" Visibility="Collapsed"
                                     DataContext="{Binding AboutDataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
